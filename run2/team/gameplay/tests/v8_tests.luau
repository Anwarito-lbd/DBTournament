local Elo = require("./_lib/Elo")
local DB = require("./_lib/DragonBalls")
local RM = require("./_lib/RaidMath")
local SS = require("./_lib/StorySchema")
local Races = require("./_lib/Races")
local Config = require("./_lib/Config")
local passed, failed = 0, 0
local function test(n, f) local o, e = pcall(f); if o then passed += 1 else failed += 1; print("FAIL " .. n .. ": " .. tostring(e)) end end
local function near(a, b, eps) if math.abs(a - b) > (eps or 1e-6) then error(("expected %s got %s"):format(b, a), 2) end end
local function eq(a, b) if a ~= b then error(("expected %s got %s"):format(tostring(b), tostring(a)), 2) end end

-- Elo
test("elo expected + k", function()
	near(Elo.expected(1000, 1000), 0.5); near(Elo.expected(1400, 1000), 0.909, 1e-3)
	eq(Elo.k(0), 32); eq(Elo.k(19), 32); eq(Elo.k(20), 20)
end)
test("elo 1v1 symmetric", function()
	local a, b = Elo.update({ { elo = 1000, games = 30 } }, { { elo = 1000, games = 30 } }, 1)
	eq(a[1], 10); eq(b[1], -10)
	local c, d = Elo.update({ { elo = 1000, games = 0 } }, { { elo = 1000, games = 0 } }, 0)
	eq(c[1], -16); eq(d[1], 16)
	local e, f = Elo.update({ { elo = 1000, games = 30 } }, { { elo = 1000, games = 30 } }, 0.5); eq(e[1], 0); eq(f[1], 0)
end)
test("elo team average", function()
	local a, b = Elo.update({ { elo = 1200, games = 30 }, { elo = 800, games = 5 } }, { { elo = 1000, games = 30 }, { elo = 1000, games = 30 } }, 1)
	eq(a[1], 10); eq(a[2], 16); eq(b[1], -10)
	eq(Elo.apply(110, -50), Elo.FLOOR)
end)
test("ranks + GP top100", function()
	eq(Elo.rank(999), "Earthling"); eq(Elo.rank(1000), "Saiyan"); eq(Elo.rank(1399), "Elite"); eq(Elo.rank(1650), "Angel")
	eq(Elo.rank(1900), "Angel"); eq(Elo.rank(1900, 5), "GrandPriest"); eq(Elo.rank(1900, 101), "Angel")
end)
test("season/decay/window", function()
	eq(Elo.season(Elo.SEASON_EPOCH), 1); eq(Elo.season(Elo.SEASON_EPOCH + 56 * 86400), 2)
	eq(Elo.decay(1500, 30), 1500) -- disabled by default
	eq(Elo.decay(1500, 30, { enabled = true, graceDays = 14, perDay = 5, floor = 1200 }), 1420)
	eq(Elo.window(0), 100); eq(Elo.window(25), 200); eq(Elo.window(999), 400)
	eq(Elo.seasonReset(1600), 1300)
end)
-- Dragon Balls / wishes
test("all shipped wishes valid (cosmetic/zeni only)", function() for _, w in DB.WISHES do assert(DB.validateWish(w), w.id) end end)
test("stat wishes rejected", function()
	eq(select(2, DB.validateWish({ id = "Power", kind = "stat", statBoost = 1.1 })), "KindNotAllowed")
	eq(select(2, DB.validateWish({ id = "Sneaky", kind = "cosmetic", statBoost = 1.1 })), "StatEffectForbidden:statBoost")
	eq(select(2, DB.validateWish({ id = "XP", kind = "zeni", zeni = 100, xp = 9 })), "StatEffectForbidden:xp")
	eq(select(2, DB.validateWish({ id = "Rich", kind = "zeni", zeni = 1e9 })), "ZeniOutOfRange")
end)
test("collect rules", function()
	local s = DB.new(); DB.refresh(s, 1760000000)
	eq(select(2, DB.collect(s, 1, 20, 10)), "TooFar")
	assert(DB.collect(s, 1, 3, 10)); eq(select(2, DB.collect(s, 1, 3, 20)), "AlreadyHave")
	eq(select(2, DB.collect(s, 2, 3, 10.5)), "TooFast"); eq(select(2, DB.collect(s, 9, 1, 30)), "BadIndex")
	for i = 2, 7 do assert(DB.collect(s, i, 1, 100 + i * 2)) end
	assert(DB.canSummon(s)); s.summoned = true
	eq(select(2, DB.canSummon(s)), "AlreadySummonedThisWeek"); eq(select(2, DB.collect(s, 1, 1, 999)), "Stone")
	eq(DB.refresh(s, 1760000000 + 8 * 86400), true); eq(DB.count(s), 0); eq(s.summoned, false)
end)
test("resolve wishes", function()
	eq(DB.resolve("Zeni", nil, 1).zeni, 3000)
	local rot = DB.rotation(5); eq(#rot, 3)
	eq(DB.resolve("OutfitRotation", rot[2], 5).cosmetic, rot[2])
	eq(select(2, DB.resolve("OutfitRotation", "Outfit_Nope", 5)), "BadChoice")
	eq(select(2, DB.resolve("Power", nil, 1)), "UnknownWish")
end)
test("positions deterministic + distinct anchors", function()
	local anchors = {}
	for i = 1, 10 do table.insert(anchors, { x = i * 100, y = 0, z = 0 }) end
	local a, b = DB.positions(42, 7, anchors), DB.positions(42, 7, anchors)
	eq(#a, 7); for i = 1, 7 do eq(a[i].x, b[i].x) end
	local c = DB.positions(43, 7, anchors); local diff = false
	for i = 1, 7 do if c[i].x ~= a[i].x then diff = true end end; assert(diff)
end)
-- Raids
test("raid scaling", function()
	near(RM.hpScale(1), 1); near(RM.hpScale(4), 2.8); near(RM.hpScale(8), 5.2); near(RM.dmgScale(8), 1.56)
	eq(RM.phase(1, { 0.66, 0.33 }), 1); eq(RM.phase(0.66, { 0.66, 0.33 }), 2); eq(RM.phase(0.2, { 0.66, 0.33 }), 3)
	eq(RM.zeni(1, 0), 150); eq(RM.zeni(3, 1), 800); eq(RM.zeni(2, 0.25), 412)
end)
test("raid drops published odds", function()
	local odds = Config.RAIDS.Broly.drops
	assert(RM.oddsValid(odds)); eq(RM.rollDrop(odds, 0), odds[1].id); eq(RM.rollDrop(odds, 0.9999), nil)
	assert(not RM.oddsValid({ { id = "a", p = 0.7 }, { id = "b", p = 0.5 } }))
	for _, rid in { "Broly", "Moro" } do local r = Config.RAIDS[rid]; assert(r.phases and r.hp and r.minPlayers and r.maxPlayers, rid) end
end)
-- Story
test("story goal parse", function()
	eq(SS.parseGoal("Survive 90s and cut the tail").seconds, 90)
	eq(SS.parseGoal("Survive 2 min to buy time").seconds, 120)
	eq(SS.parseGoal("Land 10 hits on Beerus").count, 10)
	eq(SS.parseGoal("Defeat Mecha Frieza in under 60s").type, "timed")
	eq(SS.parseGoal("Win before the 5-minute planet timer ends").seconds, 300)
	eq(SS.parseGoal("Defeat Recoome, Burter and Jeice").type, "defeat")
	eq(SS.enemyOf("Goku vs Frieza while Namek collapses"), "Frieza")
end)
test("story normalize bad data", function()
	local list, errs = SS.normalize({ { id = 1, name = "A", objective = "Survive 10s" }, { id = 1, name = "dup", objective = "x" }, 5, { id = 2 } })
	eq(#list, 1); eq(#errs, 3)
	local _, e2 = SS.normalize(nil); eq(#e2, 1)
end)
test("kai kai kit for Shin/Zamasu", function()
	eq(Races.raceOf("u7_shin"), "Kaioshin"); eq(Races.raceOf("u10_zamasu"), "Kaioshin")
	assert(table.find(Config.MOVES.KaiKai.freeForIds, "u7_shin") and table.find(Config.MOVES.KaiKai.freeForIds, "u10_zamasu"))
	assert(Config.CHAR_BY_ID.u7_shin and Config.CHAR_BY_ID.u10_zamasu)
end)
print(("%d passed, %d failed"):format(passed, failed)); if failed > 0 then error("tests failed") end
