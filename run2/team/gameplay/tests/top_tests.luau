local T = require("./_lib/ToPLogic")
local Config = require("./_lib/Config")
local Modifiers = require("./_lib/Modifiers")
local SR = require("./_lib/StatResolver")
local passed, failed = 0, 0
local function test(n, f) local o, e = pcall(f); if o then passed += 1 else failed += 1; print("FAIL " .. n .. ": " .. tostring(e)) end end
local function eq(a, b) if a ~= b then error(("expected %s got %s"):format(tostring(b), tostring(a)), 2) end end
test("show clock", function()
	eq(T.showRemaining(0, 300), 2880); eq(T.showRemaining(150, 300), 1440); eq(T.showRemaining(300, 300), 0); eq(T.showRemaining(999, 300), 0)
	eq(T.formatClock(2880), "48:00"); eq(T.formatClock(T.showRemaining(1, 300)), "47:50")
end)
test("teams scale to 40", function()
	for n = 2, 40 do
		local k, cap = T.teamCount(n, Config), T.teamCap(n, Config)
		assert(k >= 2 and k <= Config.MAX_TEAMS, n); assert(k * cap >= n, "capacity " .. n); assert(cap <= Config.MAX_TEAM_SIZE, n)
	end
	eq(T.teamCount(40, Config), 8); eq(T.teamCap(40, Config), 5); eq(T.teamCount(1, Config), 0)
end)
test("comeback rules", function()
	eq(T.comeback(3, 1, false), "LastStand"); eq(T.comeback(3, 1, true), nil); eq(T.comeback(1, 1, false), nil); eq(T.comeback(3, 2, false), nil)
	local m = Modifiers.LIST.LastStand; assert(m and m.paid, "LastStand must be paid-bucket")
end)
test("comeback stays inside 1.35x and Ranked=1", function()
	local r = SR.resolve({ race = "Saiyan", mods = { { id = "LastStand" }, { id = "EnergyDrink" } }, paid = 1.3 })
	assert(r.paid <= 1.35 + 1e-9, r.paid)
	local rr = SR.resolve({ race = "Saiyan", mods = { { id = "LastStand" } }, ranked = true }); eq(rr.paid, 1)
	local r1 = SR.resolve({ race = "Saiyan", mods = { { id = "LastStand" } } }); assert(r1.paid > 1 and r1.paid <= 1.35)
end)
test("resolve / erasure", function()
	eq(T.wiped(0), true); eq(T.wiped(nil), true); eq(T.wiped(1), false)
	local w, over = T.resolve({ A = 2, B = 0, C = 0 }, false); eq(w, "A"); eq(over, true)
	w, over = T.resolve({ A = 2, B = 1 }, false); eq(w, nil); eq(over, false)
	w, over = T.resolve({ A = 2, B = 1 }, true); eq(w, "A"); eq(over, true)
	w, over = T.resolve({ A = 2, B = 2 }, true); eq(w, nil); eq(over, true)
	w, over = T.resolve({ A = 0, B = 0 }, false); eq(w, nil); eq(over, true)
end)
test("survival event scaling", function()
	eq(T.eventTime(300), 150); eq(T.eventShould(3, 2, false), false); eq(T.eventShould(3, 2, true), true); eq(T.eventShould(10, 1, false), false)
	local hp, dm = T.eventScale(40); eq(hp, 8500); eq(dm, 1.5); local hp1, dm1 = T.eventScale(4); eq(hp1, 3100); assert(math.abs(dm1 - 1.045) < 1e-9)
end)
test("ending wishes cosmetic/zeni only", function()
	for id, w in Config.WISHES do assert(T.endingRewardOk(w), id) end
	assert(not T.endingRewardOk({ statBoost = 1.1 }))
end)
test("universe numbers give 7 to largest human team", function()
	local n = T.universeNumbers({ 2, 3, 0 }); eq(n[2], 7); eq(n[1], 1); eq(n[3], 2)
	n = T.universeNumbers({ 2, 2 }); eq(n[1], 7); eq(n[2], 1)
	n = T.universeNumbers({ 0, 0, 0 }); eq(n[1], 1); eq(n[3], 3)
	n = T.universeNumbers({ 1, 1, 1, 1, 1, 1, 1, 1 }); local seen = {}
	for _, v in n do assert(not seen[v]); seen[v] = true end; assert(seen[7])
end)
test("chunk ring-out only when detached", function()
	assert(not T.chunkRingOut(0)); assert(not T.chunkRingOut(2)); assert(T.chunkRingOut(3)); assert(T.chunkRingOut(1, true)); assert(not T.chunkRingOut(nil))
end)
test("D17 timeout tiebreak", function()
	local w, tied = T.resolveTimeout({ A = { n = 2, hp = 1.2 }, B = { n = 2, hp = 1.5 }, C = { n = 1, hp = 1 } }); eq(w, "B"); eq(#tied, 1)
	w, tied = T.resolveTimeout({ A = { n = 2, hp = 1.5 }, B = { n = 2, hp = 1.5 } }); eq(w, nil); eq(#tied, 2)
	w = T.resolveTimeout({ A = { n = 3, hp = 0.3 }, B = { n = 2, hp = 2 } }); eq(w, "A")
	w, tied = T.resolveTimeout({ A = { n = 0, hp = 0 } }); eq(w, nil); eq(#tied, 0)
end)
test("AFK thresholds", function()
	assert(not T.isAfk(0, 29, "fight")); assert(T.isAfk(0, 30, "fight")); assert(not T.isAfk(0, 60, "lobby")); assert(T.isAfk(0, 90, "lobby"))
	assert(not T.isAfk(0, 999, "fight", true))
end)
test("D19 bot fill", function()
	local f = T.botFill({ 1, 1 }); eq(f[1] + f[2], 2); eq(f[1], 1)
	f = T.botFill({ 2, 1 }); eq(f[1], 0); eq(f[2], 1)
	f = T.botFill({ 2, 2 }); eq(f[1] + f[2], 0)
	f = T.botFill({ 1, 1 }, true); eq(f[1] + f[2], 0)
	f = T.botFill({ 1 }); eq(f[1], 0)
end)
test("D18 struggle cap", function()
	assert(T.struggleCanJoin(2)); assert(not T.struggleCanJoin(3)); assert(not T.struggleCanJoin(1)); eq(T.STRUGGLE_JOIN_WEIGHT, 0.5)
end)
test("D20 fusion outcomes", function()
	eq(T.fusedOutcome("KO"), "BothOut"); eq(T.fusedOutcome("RingOut"), "BothOut"); eq(T.fusedOutcome("Leave"), "Defuse")
	assert(not T.giftAllowed("KO", true)); assert(T.giftAllowed("RingOut", false)); assert(not T.giftAllowed("AFK", false))
end)
test("X transform ladder", function()
	local L = { "KaioKen", "SuperSaiyan", "SuperSaiyan4" }
	local un = function(id) return id ~= "SuperSaiyan4" end
	eq(T.nextForm(L, "Base", un), "KaioKen"); eq(T.nextForm(L, "KaioKen", un), "SuperSaiyan"); eq(T.nextForm(L, "SuperSaiyan", un), "Base")
	eq(T.nextForm(L, "SuperSaiyan", function() return true end), "SuperSaiyan4")
end)
test("SSJ4 config", function()
	local f = Config.FORMS.SuperSaiyan4; assert(f and f.story == 32)
	assert(f.mult < Config.FORMS.MUI.mult and f.mult < Config.FORMS.UltraEgo.mult)
	assert(T.storyFormOk(f, f.level, 0, { ["32"] = true })); assert(not T.storyFormOk(f, f.level, 0, {})); assert(not T.storyFormOk(f, f.level - 1, 0, { ["32"] = true }))
	assert(table.find(Config.CHAR_BY_ID.u7_goku.forms, "SuperSaiyan4")); assert(table.find(Config.CHAR_BY_ID.u7_vegeta.forms, "SuperSaiyan4"))
end)
print(("%d passed, %d failed"):format(passed, failed)); if failed > 0 then error("tests failed") end
